# ==========================================================================
# Email Campaign Management Platform — Production Environment Variables
# ==========================================================================
# Copy this file to .env at the project root and fill in all values.
# This file is used by the unified docker-compose.yml.
# ==========================================================================

# ─── Django Core ──────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-to-a-strong-random-string
SIGNING_KEY=change-me-to-another-strong-random-string

# Generate with: docker compose exec backend python manage.py generate_encryption_key
EMAIL_CONFIG_ENCRYPTION_KEY=

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=emailcampaign-api.musfiqdehan.com,localhost

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=ecmp_production
POSTGRES_USER=ecmp_user
POSTGRES_PASSWORD=change-me-to-strong-db-password
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-strong-redis-password
# 'redis' for production (unified compose), 'redis-ecmp' if using container name
REDIS_HOST=redis

# ─── Frontend Build Args ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://emailcampaign-api.musfiqdehan.com/api/v1
NEXT_PUBLIC_WS_URL=wss://emailcampaign-api.musfiqdehan.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Email / SMTP Configuration ──────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@musfiqdehan.com

# ─── AWS SES (platform account: sending + domain identity provisioning) ──
# Required for platform-managed sending domains (SES identity/DKIM provisioning)
# EMAIL_BACKEND=django_ses.SESBackend
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=us-east-1
# AWS_SES_CONFIGURATION_SET=

# ─── VAPID Keys (Web Push Notifications) ─────────────────────────────────
# Generate with: python -c "from pywebpush import webpush; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem()); print(v.public_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@musfiqdehan.com

# ─── AI Providers ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
# OpenAI-compatible DeepSeek key used when Gemini hits rate/quota limits
DEEPSEEK_API_KEY=

# ─── Organization Provider Limits ────────────────────────────────────────
ORG_PROVIDER_MAX_RATE_PER_SECOND=10
ORG_PROVIDER_MAX_RATE_PER_MINUTE=100
ORG_PROVIDER_MAX_RATE_PER_HOUR=1000
ORG_PROVIDER_MAX_DAILY_QUOTA=10000

# ─── Superuser Credentials (used by entrypoint on first deploy) ──────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@musfiqdehan.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-strong-admin-password
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User
