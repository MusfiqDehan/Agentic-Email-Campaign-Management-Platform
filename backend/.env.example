# ==========================================================================
# Email Campaign Management Platform — Local Development Environment
# ==========================================================================
# Copy this file to .env and fill in your values.
# This file is used by backend/docker-compose.yml (local development).
# ==========================================================================

# ─── Django Core ──────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this
SIGNING_KEY=your-jwt-signing-key
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── PostgreSQL (must match docker-compose service) ──────────────────────
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=db-ecmp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db-ecmp
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password
# Use container name for local dev (service name 'redis' also works)
REDIS_HOST=redis-ecmp

# ─── Email / SMTP ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_CONFIG_ENCRYPTION_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Superuser Credentials (used by entrypoint) ─────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# ─── VAPID Keys (Web Push Notifications) ─────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@yourdomain.com

# ─── Organization Provider Limits ────────────────────────────────────────
ORG_PROVIDER_MAX_RATE_PER_SECOND=10
ORG_PROVIDER_MAX_RATE_PER_MINUTE=100
ORG_PROVIDER_MAX_RATE_PER_HOUR=1000
ORG_PROVIDER_MAX_DAILY_QUOTA=10000
